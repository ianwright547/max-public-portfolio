# Copy this file to .env for local development. Never put real secrets here.

# Local learning mode keeps using SQLite.
MAX_DATABASE_URL=sqlite:///./max.db
MAX_PUBLIC_BASE_URL=http://localhost:8000

# Production should use a PostgreSQL URL supplied by the hosting provider.
# Example shape only:
# MAX_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# OpenAI values are read only by the future live interpretation adapter.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

# The router will choose among these models instead of hard-coding one model.
OPENAI_MODEL_SOL=gpt-5.6-sol
OPENAI_MODEL_BALANCED=gpt-5.6-terra
OPENAI_MODEL_EFFICIENT=gpt-5.6-luna

# Read-only Vercel project verification. Never use this for deployment actions.
VERCEL_API_TOKEN=

# Slack uses a bot token from one verified agency workspace. Never paste the
# token into source code, reports, or Slack messages.
SLACK_BOT_TOKEN=
SLACK_WORKSPACE_ID=
# Optional comma-separated agency-owner Slack member IDs joined to every public client channel.
SLACK_OWNER_USER_IDS=
SLACK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Connections still needed for the full Max workflow
# Fill these in only after creating the provider account/app. Do not paste
# secrets into chat, source code, Slack, reports, or GitHub.
# -----------------------------------------------------------------------------

# Vercel deployment and domain management (leave blank for read-only mode).
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# External website/GBP writes remain disabled unless explicitly enabled after
# provider credentials, approval gates, and recovery procedures are verified.
MAX_ENABLE_EXTERNAL_WRITES=false
# Required for full readiness: codex_handoff (human Codex packet flow) or
# github_vercel (approved direct GitHub/Vercel executor).
MAX_FULFILLMENT_MODE=codex_handoff
# Optional paid-mode gate. When enabled, fulfillment requires an active
# subscription updated through the signed provider-neutral webhook.
MAX_BILLING_ENFORCEMENT=false
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=
# Optional external browser worker used only for tasks that cannot use an API.
BROWSER_WORKER_URL=
BROWSER_WORKER_TOKEN=

# GitHub App connection. Prefer a GitHub App over a personal access token.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_DEFAULT_BRANCH=main
# GitHub App repository verification requires PyJWT[crypto], installed from
# requirements.txt. The private key may include the BEGIN/END lines and \n.

# Google OAuth shared values. Use the refresh token after completing OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=

# Google Business Profile resource mapping.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Search Console properties are linked per client through Max. Do not put one
# client domain here as a global default. This legacy name may remain blank.
SEARCH_CONSOLE_PROPERTY=

# Routine low-cost content generation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Kimi fallback.
KIMI_API_KEY=
KIMI_MODEL=

# Client asset storage. Choose one provider and fill only that section.
BLOB_READ_WRITE_TOKEN=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Authentication (required before using real client data). Owner login reuses
# the configured Google OAuth client and callback URL above.
AUTH_SECRET=
MAX_ALLOWED_GOOGLE_EMAILS=
MAX_REQUIRE_AUTH=true

# Scheduled jobs. Set the shared secret used by the scheduler to call
# POST /jobs/run-due. Never expose this in a browser or Slack message.
JOB_RUNNER_SECRET=
# Vercel Cron sends this value as `Authorization: Bearer <value>` to the
# scheduler's GET endpoint. It may use the same generated value as
# JOB_RUNNER_SECRET, but both names must be configured in Vercel.
CRON_SECRET=
CRON_TIMEZONE=America/Chicago

# Optional monitoring and cost controls.
SENTRY_DSN=
MONTHLY_AI_BUDGET_USD=50
# Conservative preflight estimate used before an optional OpenAI onboarding
# interpretation. Actual provider invoices may differ.
OPENAI_INTERPRETATION_ESTIMATED_COST_USD=0.05
